---
import {
  isNavigationDestinationCurrent,
  isPrimaryNavCurrent,
  primaryNavigation,
} from "../data/navigation";
import ExternalLinkIcon from "./ExternalLinkIcon.astro";

interface Props {
  variant: "desktop" | "mobile";
}

const { variant } = Astro.props;
const pathname = Astro.url.pathname;
---

<nav
  id={variant === "mobile" ? "mobile-primary-navigation" : undefined}
  class:list={["primary-navigation", variant]}
  aria-label="Primary"
  data-primary-navigation={variant}
>
  <ul class="root-list">
    {
      primaryNavigation.map((item) => {
        const current = isPrimaryNavCurrent(pathname, item);

        return (
          <li
            class="root-item"
            data-nav-item={item.label}
            data-nav-kind={item.kind}
            data-nav-current={current ? "true" : undefined}
          >
            {item.kind === "menu" ? (
              <details
                class="nav-details"
                data-nav-details={item.id}
                data-nav-menu={item.label}
              >
                <summary
                  class="root-control menu-trigger"
                  aria-controls={`${variant}-${item.id}-panel`}
                  aria-expanded="false"
                  data-nav-trigger={item.id}
                >
                  <span>{item.label}</span>
                  {current && <span class="sr-only"> (current section)</span>}
                  <svg
                    class="chevron"
                    width="14"
                    height="14"
                    viewBox="0 0 16 16"
                    fill="none"
                    aria-hidden="true"
                  >
                    <path
                      d="m4 6 4 4 4-4"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </summary>

                <div
                  id={`${variant}-${item.id}-panel`}
                  class="menu-panel"
                  data-nav-panel={item.id}
                >
                  <div class="mobile-panel-head">
                    <button
                      class="panel-button back-button"
                      type="button"
                      data-nav-back
                    >
                      <svg
                        width="16"
                        height="16"
                        viewBox="0 0 16 16"
                        fill="none"
                        aria-hidden="true"
                      >
                        <path
                          d="m10 3-5 5 5 5"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                      <span>Back</span>
                    </button>
                    <strong>{item.label}</strong>
                    <button
                      class="panel-button close-button"
                      type="button"
                      aria-label="Close navigation"
                      data-nav-close
                    >
                      <svg
                        width="16"
                        height="16"
                        viewBox="0 0 16 16"
                        fill="none"
                        aria-hidden="true"
                      >
                        <path
                          d="m4 4 8 8m0-8-8 8"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                        />
                      </svg>
                    </button>
                  </div>

                  <div class="menu-grid">
                    {item.groups.map((group) => (
                      <div
                        class="menu-group"
                        role="group"
                        aria-labelledby={`${variant}-${item.id}-${group.id}-label`}
                        data-nav-group={group.id}
                      >
                        <p
                          id={`${variant}-${item.id}-${group.id}-label`}
                          class="group-label"
                        >
                          {group.label}
                        </p>
                        <ul class="destination-list">
                          {group.items.map((destination) => (
                            <li>
                              <a
                                class="destination"
                                href={destination.href}
                                aria-current={
                                  isNavigationDestinationCurrent(
                                    pathname,
                                    destination,
                                  )
                                    ? "page"
                                    : undefined
                                }
                                data-nav-destination={destination.href}
                              >
                                <span class="destination-name">
                                  {destination.label}
                                </span>
                                <span class="destination-description">
                                  {destination.description}
                                </span>
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                </div>
              </details>
            ) : (
              <a
                class:list={[
                  "root-control",
                  "direct-link",
                ]}
                href={item.href}
                target={
                  item.kind === "cta" && item.newTab ? "_blank" : undefined
                }
                rel={
                  item.kind === "cta" && item.newTab
                    ? "noopener noreferrer"
                    : undefined
                }
                aria-current={current ? "page" : undefined}
                data-nav-direct={item.href}
              >
                <span>{item.label}</span>
                {item.kind === "cta" && <ExternalLinkIcon size={13} />}
                {item.kind === "cta" && (
                  <span class="sr-only"> (opens in a new tab)</span>
                )}
              </a>
            )}
          </li>
        );
      })
    }
  </ul>
</nav>

<style>
  .primary-navigation,
  .root-list,
  .destination-list {
    margin: 0;
    padding: 0;
  }

  .root-list,
  .destination-list {
    list-style: none;
  }

  .desktop .root-list {
    display: flex;
    align-items: center;
    gap: clamp(0.65rem, 1.5vw, 1.35rem);
  }

  .root-item {
    min-width: 0;
  }

  .nav-details > summary {
    list-style: none;
  }

  .nav-details > summary::-webkit-details-marker {
    display: none;
  }

  .root-control {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    min-height: 2.75rem;
    padding-inline: 0.1rem;
    border: 0;
    color: var(--ink-soft);
    background: transparent;
    font: inherit;
    font-size: var(--ac-type-ui);
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
  }

  .root-control:hover,
  .root-control:focus-visible,
  .root-item[data-nav-current="true"] > .direct-link,
  .root-item[data-nav-current="true"] .menu-trigger,
  .nav-details[open] > .menu-trigger {
    color: var(--ink);
  }

  .root-item[data-nav-current="true"] .menu-trigger {
    font-weight: 650;
  }

  .direct-link::after {
    content: "";
    position: absolute;
    bottom: 0.05rem;
    left: 50%;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    transform: translateX(-50%) scale(0);
  }

  .root-item[data-nav-current="true"] > .direct-link::after {
    transform: translateX(-50%) scale(1);
  }

  .chevron {
    flex: 0 0 auto;
  }

  .nav-details[open] > .menu-trigger .chevron {
    transform: rotate(180deg);
  }

  .menu-panel {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--ink);
    background: var(--surface);
    box-shadow: var(--shadow-lift);
  }

  .desktop .menu-panel {
    position: absolute;
    top: calc(100% + 0.45rem);
    left: 50%;
    z-index: 30;
    width: min(calc(100vw - 2rem), var(--ac-rail-page));
    max-height: min(44rem, calc(100vh - 7rem));
    padding: clamp(1rem, 2.2vw, 1.5rem);
    overflow: auto;
    opacity: 0;
    transform: translate(-50%, -0.45rem);
    pointer-events: none;
  }

  .desktop .nav-details[open] > .menu-panel {
    opacity: 1;
    transform: translate(-50%, 0);
    pointer-events: auto;
  }

  .menu-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 2rem);
  }

  .menu-group {
    min-width: 0;
  }

  .group-label {
    margin: 0 0 0.55rem;
    padding: 0 0.65rem 0.5rem;
    border-bottom: 1px solid var(--line-soft);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 650;
    letter-spacing: 0.07em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .destination-list {
    display: grid;
    gap: 0.15rem;
  }

  .destination {
    position: relative;
    display: grid;
    gap: 0.14rem;
    min-height: 2.75rem;
    padding: 0.55rem 1.25rem 0.55rem 0.65rem;
    border-radius: 0.75rem;
    color: var(--ink);
    text-decoration: none;
  }

  .destination:hover,
  .destination:focus-visible {
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }

  .destination[aria-current="page"]::after {
    content: "";
    position: absolute;
    top: 1rem;
    right: 0.55rem;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  .destination-name {
    font-size: 0.94rem;
    font-weight: 650;
    line-height: 1.35;
  }

  .destination-description {
    color: var(--ink-soft);
    font-size: 0.79rem;
    line-height: 1.4;
  }

  .mobile-panel-head {
    display: none;
  }

  .mobile {
    position: fixed;
    inset: 5.25rem 1rem 1rem;
    z-index: 50;
    width: auto;
    padding: 0.8rem;
    overflow: auto;
    overscroll-behavior: contain;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow-lift);
  }

  :global(.site-menu:not([open])) .mobile {
    display: none;
  }

  .mobile .root-list {
    display: grid;
    gap: 0.2rem;
  }

  .mobile .root-control {
    width: 100%;
    justify-content: flex-start;
    min-height: 2.75rem;
    padding: 0.65rem 0.75rem;
    border-radius: 0.75rem;
  }

  .mobile .menu-trigger .chevron {
    margin-left: auto;
    transform: rotate(-90deg);
  }

  .mobile .nav-details[open] > .menu-trigger .chevron {
    transform: rotate(0);
  }

  .mobile .menu-trigger {
    padding-right: 0.75rem;
  }

  .mobile .direct-link::after {
    right: 0.75rem;
    bottom: 50%;
    left: auto;
    transform: translateY(50%) scale(0);
  }

  .mobile .root-item[data-nav-current="true"] > .direct-link {
    padding-right: 2rem;
  }

  .mobile .root-item[data-nav-current="true"] > .direct-link::after {
    transform: translateY(50%) scale(1);
  }

  .mobile .menu-panel {
    margin-top: 0.35rem;
    padding: 0.75rem;
    box-shadow: none;
  }

  .mobile .menu-grid {
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  .mobile.is-enhanced[data-active-menu] {
    overflow: hidden;
  }

  .mobile.is-enhanced .menu-panel {
    position: absolute;
    inset: 0;
    z-index: 2;
    margin: 0;
    padding: 0.8rem;
    overflow: auto;
    border: 0;
    border-radius: inherit;
    opacity: 0;
    transform: translateX(1rem);
    pointer-events: none;
  }

  .mobile.is-enhanced .nav-details[open] > .menu-panel {
    opacity: 1;
    transform: translateX(0);
    pointer-events: auto;
  }

  .mobile.is-enhanced .mobile-panel-head {
    position: sticky;
    top: -0.8rem;
    z-index: 3;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.5rem;
    margin: -0.8rem -0.8rem 0.75rem;
    padding: 0.65rem 0.8rem;
    border-bottom: 1px solid var(--line-soft);
    background: var(--surface);
  }

  .mobile-panel-head strong {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    text-align: center;
  }

  .panel-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    width: max-content;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0.45rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--ink);
    background: var(--surface);
    font: inherit;
    font-size: var(--ac-type-ui);
    cursor: pointer;
  }

  .close-button {
    justify-self: end;
  }

  @media (prefers-reduced-motion: no-preference) {
    .direct-link::after,
    .chevron,
    .desktop .menu-panel,
    .mobile.is-enhanced .menu-panel {
      transition:
        opacity 0.2s var(--ease-out),
        transform 0.2s var(--ease-out);
    }
  }

  @media (max-width: 24rem) {
    .mobile {
      inset-inline: 0.5rem;
      bottom: 0.5rem;
    }

    .mobile .menu-panel {
      padding-inline: 0.6rem;
    }
  }
</style>
