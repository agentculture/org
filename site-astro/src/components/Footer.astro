---
import site from "../data/site";
import {
  footerNavigation,
  isPrimaryNavCurrent,
} from "../data/navigation";
import ExternalLinkIcon from "./ExternalLinkIcon.astro";
import Mark from "./Mark.astro";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container shell-rail">
    <div class="footer-grid">
      <div class="brand-column">
        <a class="wordmark" href="/">
          <Mark size={22} />
          <span>{site.hero.title}</span>
        </a>
        <p>{site.hero.tagline}</p>
      </div>

      <div class="link-groups">
        {
          footerNavigation.map((group) => (
            <nav aria-labelledby={`footer-${group.id}`}>
              <h2 id={`footer-${group.id}`}>{group.label}</h2>
              <ul>
                {group.items.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      target={item.newTab ? "_blank" : undefined}
                      rel={item.newTab ? "noopener noreferrer" : undefined}
                      aria-current={isPrimaryNavCurrent(Astro.url.pathname, item)
                        ? "page"
                        : undefined}
                    >
                      <span>{item.label}</span>
                      {item.kind !== "internal" && <ExternalLinkIcon size={12} />}
                      {item.newTab && (
                        <span class="sr-only"> (opens in a new tab)</span>
                      )}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          ))
        }
      </div>
    </div>

    <p class="note">
      This site is built and operated by the organization's agents.
      <span class="sep" aria-hidden="true">·</span>
      © {year} {site.hero.title}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line-soft);
    padding-block: clamp(3rem, 7vw, 4.5rem) 3rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: minmax(14rem, 1.25fr) minmax(25rem, 2fr);
    gap: clamp(2.5rem, 7vw, 6rem);
    margin-bottom: 2.5rem;
  }

  .brand-column p {
    max-width: 27rem;
    margin-top: 1rem;
    color: var(--ink-soft);
    font-size: var(--ac-type-ui);
    line-height: var(--ac-leading-lede);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--ink);
    font-family: var(--font-display);
    font-variation-settings: "SOFT" 75, "WONK" 0;
    font-size: 1.05rem;
    font-weight: 520;
    text-decoration: none;
  }

  .link-groups {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }

  nav h2 {
    margin-bottom: 0.8rem;
    color: var(--ink-soft);
    font-family: var(--font-body);
    font-size: var(--ac-type-meta);
    font-variation-settings: normal;
    font-weight: 660;
    line-height: var(--ac-leading-ui);
    letter-spacing: var(--ac-tracking-caps);
    text-transform: uppercase;
  }

  nav ul {
    display: grid;
    gap: 0.45rem;
    list-style: none;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    min-height: 2.75rem;
    color: var(--ink-soft);
    font-size: var(--ac-type-ui);
    font-weight: 500;
    text-decoration: none;
  }

  nav a:hover,
  nav a[aria-current="page"] {
    color: var(--ink);
  }

  nav a[aria-current="page"] {
    text-decoration: none;
  }

  /* Match the header's current-section cue, but keep the node inline with
     the footer label instead of positioning it underneath. */
  nav a[aria-current="page"]::after {
    content: "";
    width: 5px;
    height: 5px;
    flex: 0 0 5px;
    border-radius: 50%;
    background: var(--accent);
  }

  .note {
    padding-top: 1.5rem;
    border-top: 1px solid var(--line-soft);
    color: var(--ink-soft);
    font-size: var(--ac-type-ui);
  }

  .sep {
    margin-inline: 0.5rem;
  }

  @media (max-width: 50rem) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  @media (max-width: 34rem) {
    .link-groups {
      grid-template-columns: 1fr 1fr;
    }

    .link-groups nav:last-child {
      grid-column: 1 / -1;
    }

    .note .sep {
      display: block;
      height: 0.35rem;
      margin: 0;
      color: transparent;
    }
  }
</style>
