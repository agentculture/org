---
import site from "../data/site";
import Mark from "./Mark.astro";
import PrimaryNavigation from "./PrimaryNavigation.astro";
---

<header class="site-header">
  <div class="container shell-rail bar">
    <a class="wordmark" href="/">
      <Mark />
      <span>{site.hero.title}</span>
    </a>

    <div class="desktop-menu">
      <PrimaryNavigation variant="desktop" />
    </div>

    <details class="site-menu">
      <summary aria-controls="mobile-primary-navigation">
        <span>Menu</span>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </summary>
      <PrimaryNavigation variant="mobile" />
    </details>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 20;
    padding-block: 1.4rem;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    flex: 1 1 auto;
    min-width: 0;
    gap: 0.6rem;
    color: var(--ink);
    font-family: var(--font-display);
    font-variation-settings: "SOFT" 75, "WONK" 0;
    font-size: 1.22rem;
    font-weight: 520;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .wordmark span {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .wordmark :global(.mark) {
    flex: 0 0 auto;
  }

  .site-menu {
    display: none;
  }

  @media (max-width: 51.99rem) {
    .desktop-menu {
      display: none;
    }

    .site-menu {
      position: relative;
      display: block;
      flex: 0 0 auto;
      margin-left: auto;
    }

    .site-menu > summary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.45rem;
      min-height: 2.75rem;
      padding-inline: 0.85rem;
      border: 1px solid var(--line);
      border-radius: 999px;
      color: var(--ink);
      background: var(--surface);
      box-shadow: var(--shadow);
      cursor: pointer;
      font-size: var(--ac-type-ui);
      font-weight: 600;
      list-style: none;
    }

    .site-menu > summary::-webkit-details-marker {
      display: none;
    }

    .site-menu[open] > summary svg {
      transform: rotate(180deg);
    }
  }
</style>
