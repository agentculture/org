---
export interface SectionNavItem {
  id: string;
  label: string;
}

interface Props {
  items: readonly SectionNavItem[];
  label?: string;
}

const { items, label = "On this page" } = Astro.props;
---

<nav class="section-nav" aria-label={label}>
  <span class="section-nav-label">{label}</span>
  <ul>
    {
      items.map((item) => (
        <li>
          <a href={`#${item.id}`}>{item.label}</a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .section-nav {
    margin-top: clamp(1.8rem, 4vw, 2.6rem);
    padding-top: 1.2rem;
    border-top: 1px solid var(--line-soft);
  }

  .section-nav-label {
    display: block;
    margin-bottom: 0.65rem;
    color: var(--ink-soft);
    font-size: var(--ac-type-meta);
    font-weight: 640;
    line-height: var(--ac-leading-ui);
    letter-spacing: var(--ac-tracking-caps);
    text-transform: uppercase;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    list-style: none;
  }

  a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--ink-soft);
    text-decoration: none;
    font-size: var(--ac-type-ui);
    font-weight: 560;
  }

  a:hover {
    border-color: var(--accent);
    color: var(--ink);
  }
</style>
