---
// /agents/lobes — the presentation page for lobes: what it is, the lobes it
// serves, the profiles it tunes, the machines it is validated on, and the
// Mesh-brain direction. Copy lives in ../../data/lobes.ts; every terminal
// on this page replays a real captured session from
// ../../data/lobes-captures.ts — nothing on this page dials a machine.
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import ClosingBand from "../../components/ClosingBand.astro";
import SectionIntro from "../../components/SectionIntro.astro";
import StructuredCard from "../../components/StructuredCard.astro";
import LobesDiagram from "../../components/LobesDiagram.astro";
import LobesTerminal from "../../components/LobesTerminal.astro";
import site from "../../data/site";
import lobes from "../../data/lobes";
import {
  singleMachine,
  profileDryRun,
  shapeTax,
  shapeDryRun,
  meshSpark,
  meshThor,
  meshAsk,
} from "../../data/lobes-captures";

---

<Layout
  title={`lobes · Agents · ${site.hero.title}`}
  description={lobes.hero.metaDescription}
>
  <PageHero title={lobes.hero.title} intro={lobes.hero.intro} />

  <!-- fast facts -->
  <section class="section facts-section" aria-label="Fast facts">
    <div class="container page-rail">
      <ul class="facts">
        {
          lobes.facts.map((fact, i) => (
            <li
              class="fact"
              data-reveal
              style={`--reveal-delay: ${Math.min(i * 0.07, 0.28)}s`}
            >
              <span class="fact-label muted">{fact.label}</span>
              <span class="fact-value">
                {fact.href ? (
                  <a
                    href={fact.href}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {fact.value}
                  </a>
                ) : (
                  fact.value
                )}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- what lobes serves -->
  <section id="lobes" class="section" aria-labelledby="lobes-title">
    <div class="container page-rail">
      <SectionIntro
        eyebrow="the lobes"
        title="One machine serves a small fleet of minds"
        titleId="lobes-title"
        intro={lobes.story.what}
      />
      <ul class="structured-card-grid">
        {
          lobes.roles.map((lobe, i) => (
            <StructuredCard
              title={lobe.role}
              body={lobe.duty}
              footer={lobe.model}
              revealDelay={Math.min(i * 0.07, 0.35)}
            />
          ))
        }
      </ul>
    </div>
  </section>

  <!-- the command, replayed for real -->
  <section id="command" class="section" aria-labelledby="command-title">
    <div class="container wide-rail">
      <SectionIntro
        eyebrow="the command"
        title="Watch it run — these are real captures"
        titleId="command-title"
        intro={lobes.story.commands}
      />
      <div class="term-grid">
        <div data-reveal>
          <LobesTerminal session={singleMachine} />
        </div>
        <div data-reveal style="--reveal-delay: 0.12s">
          <LobesTerminal session={profileDryRun} start={1.2} />
        </div>
      </div>
    </div>
  </section>

  <!-- profiles -->
  <section id="profiles" class="section" aria-labelledby="profiles-title">
    <div class="container wide-rail">
      <SectionIntro
        eyebrow="profiles"
        title="Tuned by purpose × machine, open to override"
        titleId="profiles-title"
        intro={lobes.profiles.intro}
      />
      <div class="tables">
        <div
          class="table-wrap card"
          data-reveal
          tabindex="0"
          role="region"
          aria-label="workload profiles table"
        >
          <h3>workload — <code>--purpose</code></h3>
          <table>
            <thead>
              <tr><th>purpose</th><th>batching</th><th>shape</th></tr>
            </thead>
            <tbody>
              {
                lobes.profiles.purposes.map((p) => (
                  <tr>
                    <td><code>{p.name}</code></td>
                    <td>{p.batching}</td>
                    <td>{p.shape}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <div
          class="table-wrap card"
          data-reveal
          style="--reveal-delay: 0.12s"
          tabindex="0"
          role="region"
          aria-label="machine profiles table"
        >
          <h3>machine — <code>--machine</code></h3>
          <table>
            <thead>
              <tr><th>machine</th><th>hardware</th><th>status</th></tr>
            </thead>
            <tbody>
              {
                lobes.profiles.machines.map((m) => (
                  <tr>
                    <td><code>{m.name}</code></td>
                    <td>{m.hardware}</td>
                    <td>
                      <span class={`status status-${m.status}`}>{m.status}</span>
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
      <div class="page-content-inset">
        <p class="table-note muted" data-reveal>
          Explicit flags always win — <code>--max-model-len</code>,{" "}
          <code>--gpu-mem-util</code>, or a new machine profile of your own.
          Full tables and measured numbers:{" "}
          <a
            href="https://github.com/agentculture/lobes-cli/blob/main/docs/tuning-profiles.md"
            target="_blank"
            rel="noopener noreferrer"
          >docs/tuning-profiles.md</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- the mesh-brain -->
  <section id="mesh-brain" class="section" aria-labelledby="mesh-brain-title">
    <div class="container wide-rail">
      <SectionIntro
        eyebrow="the mesh-brain"
        title="The brain shape you choose"
        titleId="mesh-brain-title"
        intro={lobes.meshBrain.intro}
      />
      <div class="term-grid">
        <div data-reveal>
          <LobesTerminal session={shapeTax} />
        </div>
        <div data-reveal style="--reveal-delay: 0.12s">
          <LobesTerminal session={shapeDryRun} start={1.2} />
        </div>
      </div>
      <div class="diagram-wrap" data-reveal>
        <LobesDiagram
          todayCaption={lobes.meshBrain.todayLabel}
          directionCaption={lobes.meshBrain.directionLabel}
        />
      </div>
      <div class="term-grid">
        <div data-reveal>
          <LobesTerminal session={meshSpark} />
        </div>
        <div data-reveal style="--reveal-delay: 0.12s">
          <LobesTerminal session={meshThor} start={1.0} />
        </div>
      </div>
      <div class="ask-wrap" data-reveal>
        <LobesTerminal session={meshAsk} start={0.5} wrap />
      </div>
      <div class="page-content-inset">
        <div class="prose endstate" data-reveal>
          {lobes.meshBrain.endState.map((p) => <p class="muted">{p}</p>)}
        </div>
        <p class="next-step muted" data-reveal>
          {lobes.meshBrain.nextStep}
        </p>
      </div>
    </div>
  </section>

  <!-- benchmarks -->
  <section id="benchmarks" class="section" aria-labelledby="benchmarks-title">
    <div class="container page-rail">
      <SectionIntro
        eyebrow="benchmarks"
        title="Measured, and reproducible from the repo"
        titleId="benchmarks-title"
        intro={lobes.benchmarks.intro}
      />
      <ul class="bench-grid">
        {
          lobes.benchmarks.links.map((link, i) => (
            <li
              data-reveal
              style={`--reveal-delay: ${Math.min(i * 0.08, 0.32)}s`}
            >
              <a
                class="card bench-card"
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                <h3>{link.title}</h3>
                <p class="muted">{link.description}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <ClosingBand
    name={lobes.hero.title}
    paragraphs={lobes.closing.paragraphs}
    actions={[
      {
        href: lobes.closing.repoUrl,
        label: lobes.closing.repoCta,
      },
    ]}
  />
</Layout>

<style>
  .section {
    padding-block: clamp(2.6rem, 6vh, 4.2rem);
  }

  .facts-section {
    padding-block: 0 1rem;
  }

  /* fast facts */
  .facts {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 0.9rem;
  }

  .fact {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    padding: 0.55rem 1.05rem;
    background: var(--surface);
    border: 1px solid var(--line-soft);
    border-radius: 999px;
    box-shadow: var(--shadow);
    font-size: var(--ac-type-ui);
  }

  .fact-label {
    font-size: var(--ac-type-meta);
    font-weight: 640;
    line-height: var(--ac-leading-ui);
    letter-spacing: var(--ac-tracking-caps);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .fact-value {
    font-family: var(--font-mono);
    font-size: var(--ac-type-ui);
    white-space: nowrap;
  }

  /* The shapes chip is the longest value on the row — let pills wrap on
     narrow viewports instead of overflowing the facts row. */
  @media (max-width: 480px) {
    .fact-value {
      white-space: normal;
      overflow-wrap: anywhere;
    }
  }

  /* terminals */
  .term-grid {
    margin-top: 2.2rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
    gap: 1.3rem;
    align-items: start;
  }

  .ask-wrap {
    margin-top: 1.3rem;
  }

  /* profiles tables */
  .tables {
    margin-top: 2.2rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: 1.3rem;
    align-items: start;
  }

  .table-wrap {
    padding: 1.5rem 1.6rem;
    overflow-x: auto;
  }

  .table-wrap h3 {
    font-size: var(--ac-type-meta);
    font-family: var(--font-body);
    font-variation-settings: normal;
    font-weight: 620;
    line-height: var(--ac-leading-ui);
    letter-spacing: var(--ac-tracking-caps);
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-bottom: 1rem;
  }

  /* CLI flags are case-sensitive — exempt them from the heading transform. */
  .table-wrap h3 code {
    text-transform: none;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--ac-type-ui);
    line-height: var(--ac-leading-card);
  }

  th {
    text-align: left;
    font-weight: 620;
    font-size: var(--ac-type-meta);
    line-height: var(--ac-leading-ui);
    letter-spacing: var(--ac-tracking-caps);
    text-transform: uppercase;
    color: var(--ink-soft);
    padding: 0.35rem 0.9rem 0.55rem 0;
    border-bottom: 1px solid var(--line);
  }

  td {
    padding: 0.6rem 0.9rem 0.6rem 0;
    border-bottom: 1px solid var(--line-soft);
    vertical-align: top;
  }

  tr:last-child td {
    border-bottom: none;
  }

  .status {
    display: inline-block;
    padding: 0.1rem 0.6rem;
    border-radius: 999px;
    font-size: var(--ac-type-meta);
    font-weight: 620;
    line-height: var(--ac-leading-ui);
    letter-spacing: var(--ac-tracking-caps);
  }

  .status-validated {
    color: var(--accent-strong);
    border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
  }

  .status-configured {
    color: var(--ink-soft);
    border: 1px solid var(--line);
  }

  .status-planned {
    color: var(--ink-soft);
    border: 1px dashed var(--line);
  }

  .table-note {
    margin-top: 1.4rem;
    font-size: 1rem;
    max-width: var(--ac-measure-prose);
  }

  /* diagram */
  .diagram-wrap {
    margin-block:
      var(--ac-space-diagram-before)
      var(--ac-space-diagram-after);
    max-width: 46rem;
    margin-inline: auto;
  }

  /* mesh-brain end-state + next step */
  .endstate {
    margin-top: 2.4rem;
  }

  .next-step {
    margin-top: 1.4rem;
    max-width: var(--ac-measure-prose);
    font-size: 1rem;
    line-height: var(--ac-leading-lede);
    padding-left: 1rem;
    border-left: 2px solid var(--accent);
  }

  /* benchmarks */
  .bench-grid {
    list-style: none;
    margin-top: 2.2rem;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 1.1rem;
  }

  .bench-card {
    height: 100%;
    padding: 1.5rem 1.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .bench-card h3 {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--ac-type-card-title);
    line-height: var(--ac-leading-ui);
    letter-spacing: var(--ac-tracking-heading);
    font-weight: 600;
  }

  .bench-card p {
    font-size: 1rem;
    line-height: var(--ac-leading-card);
  }

</style>
