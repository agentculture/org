---
// /agents/devague — the presentation page for devague: the seven-leg arc
// (scope → think → challenge → spec-to-plan → assign-to-workforce →
// deviate → summarize-delivery) with the execution seam where the CLI hands
// the build to operators, the announcement-frame method (scope its opening
// move, challenge reopening the frame between spec and plan), the human
// review loop extended onto the deviation ledger and the challenge pass's
// own findings, and the seven operator skills — one per leg. Real captured
// sessions now replay three runs: the frame and plan that specced and
// planned this page, the catch-up run that walked it through all six legs
// the tool had before challenge existed, and this update's own /challenge
// session — the first to run the new seventh leg — sweeping that same
// frame for blind spots and re-exporting it. Also a what's-next from the
// open tracker. All copy lives in ../../data/devague.ts — including each
// section's eyebrow and headline, a deliberate departure from lobes.ts
// documented there: this page is a presentation Ori talks over, so the
// headlines are spoken copy and live in the content model. Every terminal
// below replays a real captured session from ../../data/devague-captures.ts
// — nothing on this page runs devague in the browser.
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import ClosingBand from "../../components/ClosingBand.astro";
import SectionIntro from "../../components/SectionIntro.astro";
import StructuredCard from "../../components/StructuredCard.astro";
import DevagueFlow from "../../components/DevagueFlow.astro";
import CaptureSession from "../../components/CaptureSession.astro";
import CaptureTranscriptModal from "../../components/CaptureTranscriptModal.astro";
import site from "../../data/site";
import devague from "../../data/devague";
import { sessions } from "../../data/devague-story";

---

<Layout
  title={`devague · Agents · ${site.hero.title}`}
  description={devague.hero.metaDescription}
>
  <PageHero title={devague.hero.title} intro={devague.hero.intro} />

  <!-- fast facts -->
  <section class="section facts-section" aria-label="Fast facts">
    <div class="container page-rail">
      <ul class="facts">
        {
          devague.facts.map((fact, i) => (
            <li
              class="fact"
              data-reveal
              style={`--reveal-delay: ${Math.min(i * 0.07, 0.28)}s`}
            >
              <span class="fact-label muted">{fact.label}</span>
              <span class="fact-value">
                {fact.href ? (
                  <a
                    href={fact.href}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {fact.value}
                  </a>
                ) : (
                  fact.value
                )}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- the pipeline — with the method arc as the centerpiece -->
  <section id="pipeline" class="section" aria-labelledby="pipeline-title">
    <div class="container page-rail">
      <SectionIntro
        eyebrow={devague.pipeline.eyebrow}
        title={devague.pipeline.headline}
        titleId="pipeline-title"
        intro={devague.pipeline.intro}
      />
      <div class="flow-wrap" data-reveal>
        <DevagueFlow
          caption="The whole arc in one pass: claims arrive proposed, a human confirms them, and the converge gate stays shut until the frame closes — then the spec exports. A challenge pass hunts its blind spots and a human adjudicates what it finds, and the re-exported spec fans out into the waves a workforce builds. Where the build must leave that plan, the run stops and the approved departure lands on the deviate ledger; the closing summary reconciles planned against actual — the accountability artifact."
        />
      </div>
      <ol
        class="card pipeline-stage-list"
        aria-label="The seven stages from idea to accountable delivery"
        data-reveal
      >
        {
          devague.pipeline.stages.map((stage) => (
            <li class="pipeline-stage-row">
              <div class="pipeline-stage-heading">
                <p class="pipeline-stage-engine">{stage.engine}</p>
                <h3 class="pipeline-stage-name">{stage.name}</h3>
              </div>

              <div class="pipeline-stage-body">
                <p class="pipeline-stage-detail muted">{stage.detail}</p>
                <ul
                  class="pipeline-stage-chips muted"
                  data-code-chip-footer
                >
                  {
                    stage.verbs.split(" · ").map((verb) => (
                      <li><code data-code-chip>{verb}</code></li>
                    ))
                  }
                </ul>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- the announcement-frame method -->
  <section id="method" class="section" aria-labelledby="method-title">
    <div class="container page-rail">
      <SectionIntro
        eyebrow={devague.method.eyebrow}
        title={devague.method.headline}
        titleId="method-title"
        intro={devague.method.intro}
      />
      <ol class="structured-card-grid method-moves">
        {
          devague.method.moves.map((move, i) => (
            <StructuredCard
              meta={`${String(i + 1).padStart(2, "0")} · ${move.verb}`}
              title={move.ask}
              body={move.detail}
              featured={i === 0}
              revealDelay={Math.min(i * 0.07, 0.35)}
            />
          ))
        }
      </ol>
    </div>
  </section>

  <!-- the human review loop -->
  <section id="human-gate" class="section" aria-labelledby="human-gate-title">
    <div class="container page-rail">
      <SectionIntro
        eyebrow={devague.reviewLoop.eyebrow}
        title={devague.reviewLoop.headline}
        titleId="human-gate-title"
        intro={devague.reviewLoop.intro}
      />
      <ul class="gate-steps">
        {
          devague.reviewLoop.steps.map((step, i) => (
            <li
              class="card gate-step"
              data-reveal
              style={`--reveal-delay: ${Math.min(i * 0.07, 0.28)}s`}
            >
              <div class="gate-step-body">
                <p class="gate-eyebrow">
                  <span aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                  {" · "}
                  <span>{step.kind}</span>
                </p>
                <h3 class="gate-title">{step.title}</h3>
                <p class="gate-effect muted">
                  {
                    step.effect.map((part) =>
                      typeof part === "string" ? part : <code>{part.code}</code>
                    )
                  }
                </p>
              </div>

              <figure class="gate-mock">
                <figcaption class="gate-mock-head">
                  <span class="gate-mock-dot" aria-hidden="true"></span>
                  <span class="gate-mock-label">human gate</span>
                </figcaption>
                <code class="gate-mock-cmd">
                  <span class="gate-mock-prompt" aria-hidden="true">$</span>
                  {step.cmd}
                </code>
              </figure>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- the operator skills -->
  <section
    id="operator-skills"
    class="section"
    aria-labelledby="operator-skills-title"
  >
    <div class="container page-rail">
      <SectionIntro
        eyebrow={devague.skills.eyebrow}
        title={devague.skills.headline}
        titleId="operator-skills-title"
        intro={devague.skills.intro}
      />
      <ul class="structured-card-grid">
        {
          devague.skills.cards.map((card, i) => (
            <StructuredCard
              meta={card.leg}
              title={card.name}
              titleKind="code"
              body={card.duty}
              revealDelay={Math.min(i * 0.07, 0.35)}
            />
          ))
        }
      </ul>
    </div>
  </section>

  <!-- real captures: the dogfood loop, replayed -->
  <section id="real-captures" class="section" aria-labelledby="real-captures-title">
    <div class="container page-rail">
      <SectionIntro
        eyebrow={devague.captures.eyebrow}
        title={devague.captures.headline}
        titleId="real-captures-title"
        intro={devague.captures.intro}
      />
      {sessions.map((session) => <CaptureSession session={session} />)}
      <p class="provenance muted" data-reveal>{devague.captures.provenance}</p>
      <CaptureTranscriptModal />
    </div>
  </section>

  <!-- what's next, from the open tracker -->
  <section id="whats-next" class="section" aria-labelledby="whats-next-title">
    <div class="container page-rail">
      <SectionIntro
        eyebrow={devague.whatsNext.eyebrow}
        title={devague.whatsNext.headline}
        titleId="whats-next-title"
        intro={devague.whatsNext.intro}
      />
      <ul class="themes">
        {
          devague.whatsNext.themes.map((theme, i) => (
            <li
              class="card theme-card"
              data-reveal
              style={`--reveal-delay: ${Math.min(i * 0.08, 0.24)}s`}
            >
              <h3 class="theme-name">{theme.name}</h3>
              <p class="theme-direction muted">{theme.direction}</p>
              <ul class="theme-issues">
                {theme.issues.map((issue) => (
                  <li>
                    <a
                      href={issue.url}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      <span class="issue-num">#{issue.number}</span>{" "}
                      {issue.title}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <ClosingBand
    name={devague.hero.title}
    paragraphs={devague.closing.paragraphs}
    actions={[
      {
        href: devague.closing.repoUrl,
        label: devague.closing.repoCta,
      },
      {
        href: devague.closing.pypiUrl,
        label: devague.closing.pypiCta,
        treatment: "code",
      },
    ]}
  />
</Layout>

<script>
  document.querySelectorAll("[data-session-toggle]").forEach((toggle) => {
    if (!(toggle instanceof HTMLButtonElement)) return;
    const controlledId = toggle.getAttribute("aria-controls");
    const walkthrough = controlledId
      ? document.getElementById(controlledId)
      : null;
    const label = toggle.querySelector("[data-session-toggle-label]");
    if (!(walkthrough instanceof HTMLElement) || !(label instanceof HTMLElement)) {
      return;
    }

    walkthrough.hidden = true;
    toggle.hidden = false;
    const session = toggle.closest(".session-block");
    const more = session?.querySelector("[data-session-more]");
    if (more instanceof HTMLElement) more.hidden = false;

    toggle.addEventListener("click", () => {
      const expanded = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", String(!expanded));
      walkthrough.hidden = expanded;
      label.textContent = expanded
        ? "Walk through this session"
        : "Hide this session’s walkthrough";
    });
  });
</script>

<style>
  .section {
    padding-block: clamp(2.6rem, 6vh, 4.2rem);
  }

  .facts-section {
    padding-block: 0 1rem;
  }

  /* fast facts */
  .facts {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 0.9rem;
  }

  .fact {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    padding: 0.55rem 1.05rem;
    background: var(--surface);
    border: 1px solid var(--line-soft);
    border-radius: 999px;
    box-shadow: var(--shadow);
    font-size: var(--ac-type-ui);
  }

  .fact-label {
    font-size: var(--ac-type-meta);
    font-weight: 640;
    line-height: var(--ac-leading-ui);
    letter-spacing: var(--ac-tracking-caps);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .fact-value {
    font-family: var(--font-mono);
    font-size: var(--ac-type-ui);
    white-space: nowrap;
  }

  /* the pipeline */
  .flow-wrap {
    margin-block:
      var(--ac-space-diagram-before)
      var(--ac-space-diagram-after);
    max-width: 56rem;
    margin-inline: auto;
  }

  .pipeline-stage-list {
    width: 100%;
    max-width: 52rem;
    margin: 0 auto;
    padding: 0 1.65rem;
    list-style: none;
  }

  .pipeline-stage-row {
    display: grid;
    grid-template-columns: minmax(11rem, 12.5rem) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 2.2rem);
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--line-soft);
  }

  .pipeline-stage-row:last-child {
    border-bottom: 0;
  }

  .pipeline-stage-heading,
  .pipeline-stage-body {
    min-width: 0;
  }

  .pipeline-stage-heading {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding-top: 0.2rem;
  }

  .pipeline-stage-engine {
    margin: 0;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--ac-type-meta);
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: var(--ac-tracking-caps);
    text-transform: uppercase;
  }

  .pipeline-stage-name {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--ac-type-component-title);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: var(--ac-tracking-heading);
    overflow-wrap: anywhere;
  }

  .pipeline-stage-detail {
    margin: 0;
    font-size: 1rem;
    line-height: var(--ac-leading-card);
  }

  .pipeline-stage-chips {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0.35rem;
    margin: 0;
    padding: 0.75rem 0 0;
    list-style: none;
  }

  .pipeline-stage-chips code {
    display: inline-block;
    max-width: 100%;
    padding: 0.1em 0.45em;
    border-radius: 0.25rem;
    background: var(--line-soft);
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: var(--ac-type-meta);
    line-height: var(--ac-leading-card);
    letter-spacing: var(--ac-tracking-flat);
    overflow-wrap: anywhere;
    white-space: normal;
  }

  /* the method — retain the review mock's compact, naturally sized
     composition instead of inheriting the shared equal-height card grid */
  .structured-card-grid.method-moves {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    grid-auto-rows: auto;
    gap: 1.1rem;
    margin-block: 2.2rem 0;
  }

  .structured-card-grid.method-moves :global(.structured-card) {
    padding: 1.4rem 1.5rem;
  }

  .structured-card-grid.method-moves :global(.structured-card__meta) {
    margin-bottom: 0;
    font-size: 0.75rem;
    font-weight: 400;
    line-height: 1.7;
  }

  .structured-card-grid.method-moves :global(.structured-card__title) {
    margin-block: 0.75rem;
    font-size: 1.15rem;
    line-height: 1.35;
  }

  .structured-card-grid.method-moves :global(.structured-card__body) {
    font-size: 0.92rem;
    line-height: 1.55;
  }

  @media (max-width: 42.5rem) {
    .pipeline-stage-list {
      padding-inline: 1.15rem;
    }

    .pipeline-stage-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.85rem;
    }

    .pipeline-stage-heading {
      gap: 0.4rem;
      padding-top: 0;
    }
  }

  /* the review loop */
  .gate-steps {
    list-style: none;
    margin-top: 2.2rem;
    display: grid;
    gap: 0.85rem;
  }

  .gate-step {
    padding: 1.15rem 1.5rem;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 3rem;
  }

  .gate-step-body {
    min-width: 0;
    flex: 1 1 auto;
  }

  .gate-eyebrow {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--ac-type-meta);
    font-weight: 400;
    line-height: var(--ac-leading-card);
    letter-spacing: var(--ac-tracking-caps);
    text-transform: uppercase;
    color: var(--accent);
  }

  .gate-title {
    margin: 0.75rem 0;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: var(--ac-tracking-heading);
    color: var(--ink);
  }

  .gate-effect {
    margin: 0;
    max-width: var(--ac-measure-prose);
    font-size: var(--ac-type-ui);
    line-height: var(--ac-leading-card);
  }

  .gate-effect code {
    font-size: 0.92em;
  }

  .gate-mock {
    width: 12rem;
    height: 12rem;
    margin: 0;
    flex: none;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: #10142b;
    border: 1px solid rgba(233, 236, 248, 0.12);
    border-radius: 0.6rem;
  }

  .gate-mock-head {
    flex: none;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 0.7rem;
    border-bottom: 1px solid rgba(233, 236, 248, 0.1);
  }

  .gate-mock-dot {
    width: 0.45rem;
    height: 0.45rem;
    flex: none;
    border-radius: 50%;
    background: #7fdcc9;
  }

  .gate-mock-label {
    color: #c7cde8;
    font-family: var(--font-mono);
    font-size: var(--ac-type-meta);
    line-height: var(--ac-leading-ui);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .gate-mock-cmd {
    padding: 0.6rem 0.65rem;
    overflow: hidden;
    color: #e9ecf8;
    font-family: var(--font-mono);
    font-size: var(--ac-type-terminal);
    line-height: var(--ac-leading-card);
    letter-spacing: var(--ac-tracking-flat);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .gate-mock-prompt {
    margin-right: 0.35em;
    color: #7fdcc9;
  }

  @media (max-width: 40rem) {
    .gate-step {
      flex-direction: column;
      gap: 1.15rem;
    }
  }

  /* real captures — scoped to this section even across child components */
  :global(#real-captures .session-row) {
    margin-top: 2.75rem;
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(18rem, 1fr);
    align-items: start;
    gap: 1.75rem;
  }

  :global(#real-captures .session-block) {
    min-width: 0;
    min-height: 38rem;
    padding: 2rem 2.25rem 2.25rem;
    background: var(--surface);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  :global(#real-captures .session-meta) {
    margin: 0 0 0.75rem;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: var(--ac-tracking-caps);
    text-transform: uppercase;
  }

  :global(#real-captures .session-title) {
    margin: 0 0 0.75rem;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  :global(#real-captures .session-intro p) {
    margin: 0;
    color: var(--ink-soft);
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.65;
  }

  :global(#real-captures .session-toggle) {
    min-height: 44px;
    margin-top: 1.5rem;
    padding: 0.55rem 1.15rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--accent);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 999px;
    box-shadow: var(--shadow);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 650;
    cursor: pointer;
  }

  :global(#real-captures .session-toggle:hover) {
    border-color: var(--accent);
  }

  :global(#real-captures .session-toggle:focus-visible),
  :global(#real-captures .pane-link-btn:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  :global(#real-captures .session-toggle-icon) {
    width: 0.55rem;
    height: 0.55rem;
    flex: none;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-1px) rotate(45deg);
  }

  :global(#real-captures .session-toggle[aria-expanded="true"] .session-toggle-icon) {
    transform: translateY(1px) rotate(225deg);
  }

  :global(#real-captures .session-beats-wrap[hidden]) {
    display: none;
  }

  :global(#real-captures .beats) {
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  :global(#real-captures .beat) {
    display: flex;
    gap: 1rem;
  }

  :global(#real-captures .beat:not(:last-child)) {
    padding-bottom: 1.6rem;
  }

  :global(#real-captures .beat-rail) {
    width: 10px;
    flex: none;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  :global(#real-captures .beat-dot) {
    width: 10px;
    height: 10px;
    flex: none;
    border-radius: 50%;
    background: var(--accent);
  }

  :global(#real-captures .beat-rail-line) {
    width: 1px;
    flex: 1;
    margin-top: 0.4rem;
    background: var(--line);
  }

  :global(#real-captures .beat:last-child .beat-rail-line) {
    display: none;
  }

  :global(#real-captures .beat-body) {
    min-width: 0;
    flex: 1;
  }

  :global(#real-captures .beat-headline) {
    margin: 0 0 0.35rem;
    color: var(--ink);
    font-size: 0.98rem;
    font-weight: 650;
    line-height: 1.4;
  }

  :global(#real-captures .beat-narration) {
    margin: 0;
    color: var(--ink-soft);
    font-family: var(--font-display);
    font-size: 1.02rem;
    font-weight: 440;
    line-height: 1.55;
  }

  :global(#real-captures .beat-excerpt) {
    margin-top: 0.85rem;
    padding: 0.75rem 1rem;
    overflow-x: auto;
    background: #10142b;
    border-radius: 0.65rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.6;
  }

  :global(#real-captures .beat-line) {
    margin: 0;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  :global(#real-captures .beat-line-cmd) {
    color: #e9ecf8;
  }

  :global(#real-captures .beat-line-out) {
    color: #c7cde8;
  }

  :global(#real-captures .beat-line-ellipsis) {
    display: flex;
    gap: 0.45rem;
    color: #a9b0cf;
    font-size: 0.88em;
    font-style: italic;
  }

  :global(#real-captures .beat-prompt),
  :global(#real-captures .beat-cut) {
    margin-right: 0.4em;
    font-weight: 650;
  }

  :global(#real-captures .beat-note) {
    margin: 0.55rem 0 0;
    color: #c7cde8;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-style: italic;
  }

