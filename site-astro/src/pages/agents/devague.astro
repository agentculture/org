---
// /agents/devague — the presentation page for devague: the seven-leg arc
// (scope → think → challenge → spec-to-plan → assign-to-workforce →
// deviate → summarize-delivery) with the execution seam where the CLI hands
// the build to operators, the announcement-frame method (scope its opening
// move, challenge reopening the frame between spec and plan), the human
// review loop extended onto the deviation ledger and the challenge pass's
// own findings, and the seven operator skills — one per leg. Real captured
// sessions now replay three runs: the frame and plan that specced and
// planned this page, the catch-up run that walked it through all six legs
// the tool had before challenge existed, and this update's own /challenge
// session — the first to run the new seventh leg — sweeping that same
// frame for blind spots and re-exporting it. Also a what's-next from the
// open tracker. All copy lives in ../../data/devague.ts — including each
// section's eyebrow and headline, a deliberate departure from lobes.ts
// documented there: this page is a presentation Ori talks over, so the
// headlines are spoken copy and live in the content model. Every terminal
// below replays a real captured session from ../../data/devague-captures.ts
// — nothing on this page runs devague in the browser.
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import ClosingBand from "../../components/ClosingBand.astro";
import SectionIntro from "../../components/SectionIntro.astro";
import StructuredCard from "../../components/StructuredCard.astro";
import DevagueFlow from "../../components/DevagueFlow.astro";
import DevagueTerminal from "../../components/DevagueTerminal.astro";
import site from "../../data/site";
import devague from "../../data/devague";
import {
  frameAnnounceCapture,
  frameInterrogateReviewShift,
  frameGateConvergeExport,
  planTaskConvergeExport,
  scopeSurveySeeds,
  frameGateLiveRefusal,
  deviateLedgerRead,
  summarySkeletonRead,
  challengeSweepRoute,
  challengeAdjudicateReexport,
} from "../../data/devague-captures";

---

<Layout
  title={`devague · Agents · ${site.hero.title}`}
  description={devague.hero.metaDescription}
>
  <PageHero title={devague.hero.title} intro={devague.hero.intro} />

  <!-- fast facts -->
  <section class="section facts-section" aria-label="Fast facts">
    <div class="container page-rail">
      <ul class="facts">
        {
          devague.facts.map((fact, i) => (
            <li
              class="fact"
              data-reveal
              style={`--reveal-delay: ${Math.min(i * 0.07, 0.28)}s`}
            >
              <span class="fact-label muted">{fact.label}</span>
              <span class="fact-value">
                {fact.href ? (
                  <a
                    href={fact.href}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {fact.value}
                  </a>
                ) : (
                  fact.value
                )}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- the pipeline — with the method arc as the centerpiece -->
  <section id="pipeline" class="section" aria-labelledby="pipeline-title">
    <div class="container page-rail">
      <SectionIntro
        eyebrow={devague.pipeline.eyebrow}
        title={devague.pipeline.headline}
        titleId="pipeline-title"
        intro={devague.pipeline.intro}
      />
      <div class="flow-wrap" data-reveal>
        <DevagueFlow
          caption="The whole arc in one pass: claims arrive proposed, a human confirms them, and the converge gate stays shut until the frame closes — then the spec exports. A challenge pass hunts its blind spots and a human adjudicates what it finds, and the re-exported spec fans out into the waves a workforce builds. Where the build must leave that plan, the run stops and the approved departure lands on the deviate ledger; the closing summary reconciles planned against actual — the accountability artifact."
        />
      </div>
      <ul class="structured-card-grid">
        {
          devague.pipeline.stages.map((stage, i) => (
            <StructuredCard
              meta={stage.engine}
              title={stage.name}
              body={stage.detail}
              footerItems={stage.verbs.split(" · ")}
              revealDelay={Math.min(i * 0.07, 0.35)}
            />
          ))
        }
      </ul>
    </div>
  </section>

  <!-- the announcement-frame method -->
  <section id="method" class="section" aria-labelledby="method-title">
    <div class="container page-rail">
      <SectionIntro
        eyebrow={devague.method.eyebrow}
        title={devague.method.headline}
        titleId="method-title"
        intro={devague.method.intro}
      />
      <ol class="structured-card-grid method-moves">
        {
          devague.method.moves.map((move, i) => (
            <StructuredCard
              meta={`${String(i + 1).padStart(2, "0")} · ${move.verb}`}
              title={move.ask}
              body={move.detail}
              featured={i === 0}
              revealDelay={Math.min(i * 0.07, 0.35)}
            />
          ))
        }
      </ol>
    </div>
  </section>

  <!-- the human review loop -->
  <section id="human-gate" class="section" aria-labelledby="human-gate-title">
    <div class="container page-rail">
      <SectionIntro
        eyebrow={devague.reviewLoop.eyebrow}
        title={devague.reviewLoop.headline}
        titleId="human-gate-title"
        intro={devague.reviewLoop.intro}
      />
      <ul class="gate-steps">
        {
          devague.reviewLoop.steps.map((step, i) => (
            <li
              class="card gate-step"
              data-reveal
              style={`--reveal-delay: ${Math.min(i * 0.07, 0.28)}s`}
            >
              <div class="gate-step-body">
                <p class="gate-eyebrow">
                  <span aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                  {" · "}
                  <span>{step.kind}</span>
                </p>
                <h3 class="gate-title">{step.title}</h3>
                <p class="gate-effect muted">
                  {
                    step.effect.map((part) =>
                      typeof part === "string" ? part : <code>{part.code}</code>
                    )
                  }
                </p>
              </div>

              <figure class="gate-mock">
                <figcaption class="gate-mock-head">
                  <span class="gate-mock-dot" aria-hidden="true"></span>
                  <span class="gate-mock-label">human gate</span>
                </figcaption>
                <code class="gate-mock-cmd">
                  <span class="gate-mock-prompt" aria-hidden="true">$</span>
                  {step.cmd}
                </code>
              </figure>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- the operator skills -->
  <section
    id="operator-skills"
    class="section"
    aria-labelledby="operator-skills-title"
  >
    <div class="container page-rail">
      <SectionIntro
        eyebrow={devague.skills.eyebrow}
        title={devague.skills.headline}
        titleId="operator-skills-title"
        intro={devague.skills.intro}
      />
      <ul class="structured-card-grid">
        {
          devague.skills.cards.map((card, i) => (
            <StructuredCard
              meta={card.leg}
              title={card.name}
              titleKind="code"
              body={card.duty}
              revealDelay={Math.min(i * 0.07, 0.35)}
            />
          ))
        }
      </ul>
    </div>
  </section>

  <!-- real captures: the dogfood loop, replayed -->
  <section id="real-captures" class="section" aria-labelledby="real-captures-title">
    <div class="container page-rail">
      <SectionIntro
        eyebrow={devague.captures.eyebrow}
        title={devague.captures.headline}
        titleId="real-captures-title"
        intro={devague.captures.intro}
      />
      <!-- story one, the original run — the frame leg opens: the
           announcement, then the mid-session shift -->
      <div class="term-grid">
        <div data-reveal>
          <DevagueTerminal pane={frameAnnounceCapture} />
        </div>
        <div data-reveal style="--reveal-delay: 0.12s">
          <DevagueTerminal pane={frameInterrogateReviewShift} start={1.4} />
        </div>
      </div>
      <!-- the two gates, side by side: the frame converges, then the plan -->
      <div class="term-grid">
        <div data-reveal>
          <DevagueTerminal pane={frameGateConvergeExport} />
        </div>
        <div data-reveal style="--reveal-delay: 0.12s">
          <DevagueTerminal pane={planTaskConvergeExport} start={1.4} />
        </div>
      </div>
      <!-- story two, this update's run — the scope survey seeds the frame,
           then the gate refuses live and Ori decides mid-session -->
      <div class="term-grid">
        <div data-reveal>
          <DevagueTerminal pane={scopeSurveySeeds} />
        </div>
        <div data-reveal style="--reveal-delay: 0.12s">
          <DevagueTerminal pane={frameGateLiveRefusal} start={1.4} />
        </div>
      </div>
      <!-- the execution seam closes the loop: the ledger read is four lines
           on purpose (no deviation occurred — honesty over padding), so it
           takes the narrow column beside the summary skeleton -->
      <div class="term-grid seam">
        <div data-reveal>
          <DevagueTerminal pane={deviateLedgerRead} />
        </div>
        <div data-reveal style="--reveal-delay: 0.12s">
          <DevagueTerminal pane={summarySkeletonRead} start={1.4} />
        </div>
      </div>
      <!-- story three: the new seventh leg ran on this very update's own
           frame — the challenge pass swept it for blind spots and routed
           the finding as proposed content for the human to adjudicate, and
           the same dated spec file re-exported -->
      <div class="term-grid">
        <div data-reveal>
          <DevagueTerminal pane={challengeSweepRoute} />
        </div>
        <div data-reveal style="--reveal-delay: 0.12s">
          <DevagueTerminal pane={challengeAdjudicateReexport} start={1.4} />
        </div>
      </div>
      <p class="provenance muted" data-reveal>{devague.captures.provenance}</p>
    </div>
  </section>

  <!-- what's next, from the open tracker -->
  <section id="whats-next" class="section" aria-labelledby="whats-next-title">
    <div class="container page-rail">
      <SectionIntro
        eyebrow={devague.whatsNext.eyebrow}
        title={devague.whatsNext.headline}
        titleId="whats-next-title"
        intro={devague.whatsNext.intro}
      />
      <ul class="themes">
        {
          devague.whatsNext.themes.map((theme, i) => (
            <li
              class="card theme-card"
              data-reveal
              style={`--reveal-delay: ${Math.min(i * 0.08, 0.24)}s`}
            >
              <h3 class="theme-name">{theme.name}</h3>
              <p class="theme-direction muted">{theme.direction}</p>
              <ul class="theme-issues">
                {theme.issues.map((issue) => (
                  <li>
                    <a
                      href={issue.url}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      <span class="issue-num">#{issue.number}</span>{" "}
                      {issue.title}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <ClosingBand
    name={devague.hero.title}
    paragraphs={devague.closing.paragraphs}
    actions={[
      {
        href: devague.closing.repoUrl,
        label: devague.closing.repoCta,
      },
      {
        href: devague.closing.pypiUrl,
        label: devague.closing.pypiCta,
        treatment: "code",
      },
    ]}
  />
</Layout>

<style>
  .section {
    padding-block: clamp(2.6rem, 6vh, 4.2rem);
  }

  .facts-section {
    padding-block: 0 1rem;
  }

  /* fast facts */
  .facts {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 0.9rem;
  }

  .fact {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    padding: 0.55rem 1.05rem;
    background: var(--surface);
    border: 1px solid var(--line-soft);
    border-radius: 999px;
    box-shadow: var(--shadow);
    font-size: var(--ac-type-ui);
  }

  .fact-label {
    font-size: var(--ac-type-meta);
    font-weight: 640;
    line-height: var(--ac-leading-ui);
    letter-spacing: var(--ac-tracking-caps);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .fact-value {
    font-family: var(--font-mono);
    font-size: var(--ac-type-ui);
    white-space: nowrap;
  }

  /* the pipeline */
  .flow-wrap {
    margin-block: 2.8rem 3rem;
    max-width: 56rem;
    margin-inline: auto;
  }

  /* the method — retain the review mock's compact, naturally sized
     composition instead of inheriting the shared equal-height card grid */
  .structured-card-grid.method-moves {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    grid-auto-rows: auto;
    gap: 1.1rem;
    margin-block: 2.2rem 0;
  }

  .structured-card-grid.method-moves :global(.structured-card) {
    padding: 1.4rem 1.5rem;
  }

  .structured-card-grid.method-moves :global(.structured-card__meta) {
    margin-bottom: 0;
    font-size: 0.75rem;
    font-weight: 400;
    line-height: 1.7;
  }

  .structured-card-grid.method-moves :global(.structured-card__title) {
    margin-block: 0.75rem;
    font-size: 1.15rem;
    line-height: 1.35;
  }

  .structured-card-grid.method-moves :global(.structured-card__body) {
    font-size: 0.92rem;
    line-height: 1.55;
  }

  /* the review loop */
  .gate-steps {
    list-style: none;
    margin-top: 2.2rem;
    display: grid;
    gap: 0.85rem;
  }

  .gate-step {
    padding: 1.15rem 1.5rem;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 3rem;
  }

  .gate-step-body {
    min-width: 0;
    flex: 1 1 auto;
  }

  .gate-eyebrow {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--ac-type-meta);
    font-weight: 400;
    line-height: var(--ac-leading-card);
    letter-spacing: var(--ac-tracking-caps);
    text-transform: uppercase;
    color: var(--accent);
  }

  .gate-title {
    margin: 0.75rem 0;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: var(--ac-tracking-heading);
    color: var(--ink);
  }

  .gate-effect {
    margin: 0;
    max-width: var(--ac-measure-prose);
    font-size: var(--ac-type-ui);
    line-height: var(--ac-leading-card);
  }

  .gate-effect code {
    font-size: 0.92em;
  }

  .gate-mock {
    width: 12rem;
    height: 12rem;
    margin: 0;
    flex: none;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: #10142b;
    border: 1px solid rgba(233, 236, 248, 0.12);
    border-radius: 0.6rem;
  }

  .gate-mock-head {
    flex: none;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 0.7rem;
    border-bottom: 1px solid rgba(233, 236, 248, 0.1);
  }

  .gate-mock-dot {
    width: 0.45rem;
    height: 0.45rem;
    flex: none;
    border-radius: 50%;
    background: #7fdcc9;
  }

  .gate-mock-label {
    color: #c7cde8;
    font-family: var(--font-mono);
    font-size: var(--ac-type-meta);
    line-height: var(--ac-leading-ui);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .gate-mock-cmd {
    padding: 0.6rem 0.65rem;
    overflow: hidden;
    color: #e9ecf8;
    font-family: var(--font-mono);
    font-size: var(--ac-type-terminal);
    line-height: var(--ac-leading-card);
    letter-spacing: var(--ac-tracking-flat);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .gate-mock-prompt {
    margin-right: 0.35em;
    color: #7fdcc9;
  }

  @media (max-width: 40rem) {
    .gate-step {
      flex-direction: column;
      gap: 1.15rem;
    }
  }

  /* captures */
  .term-grid {
    margin-top: 2.2rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
    gap: 1.3rem;
    align-items: start;
  }

  .term-grid + .term-grid {
    margin-top: 1.3rem;
  }

  /* the seam row: the deliberately short ledger read takes the narrow
     column, the summary skeleton the wide one; below the sibling grids'
     natural two-column width it stacks like every other row */
  .term-grid.seam {
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
  }

  @media (max-width: 52rem) {
    .term-grid.seam {
      grid-template-columns: 1fr;
    }
  }

  .provenance {
    margin-top: 1.4rem;
    font-size: var(--ac-type-ui);
    max-width: var(--ac-measure-prose);
  }

  /* what's next */
  .themes {
    list-style: none;
    margin-top: 2.2rem;
    display: grid;
    gap: 1.1rem;
  }

  .theme-card {
    padding: 1.6rem 1.8rem;
  }

  .theme-name {
    margin-bottom: 0.4em;
  }

  .theme-direction {
    font-size: 1rem;
    line-height: var(--ac-leading-card);
    max-width: var(--ac-measure-prose);
  }

  .theme-issues {
    list-style: none;
    margin-top: 1rem;
    display: grid;
    gap: 0.4rem;
  }

  .theme-issues li {
    font-size: 1rem;
    line-height: var(--ac-leading-card);
  }

  .issue-num {
    font-family: var(--font-mono);
    font-size: var(--ac-type-meta);
    font-weight: 600;
  }

</style>
