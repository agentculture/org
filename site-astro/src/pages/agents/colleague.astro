---
// /agents/colleague — the presentation page for colleague: a swappable
// coder-agent harness — one runtime, many minds. The arc: the paradigm
// (harness, not model; mock vs vllm-openai; the field-work split with
// Claude), the three honest render tiers of one CockpitState (human, agent,
// bot), the bounded work loop (typed contract, write isolation, the seven
// base tools, pre-finish gates, handoff, piloting), the typed subagent
// workforce (five roles, four of them structurally read-only), the
// cortex/senses mind split resolved by role from a lobes gateway, eidetic
// memory (the measured warm-vs-cold pair), the rest of the surface
// catalogue, a dogfood section proving all of it on colleague's own work —
// including this very page — and a what's-next drawn from the live open
// tracker. Closes with the same two-CTA idiom as devague.astro: repo, then
// install.
//
// All copy — eyebrows, headlines, intros, and every card/table cell — lives
// in ../../data/colleague.ts, the same convention as devague.ts: this page
// is a presentation Ori talks over, so the headlines are spoken copy and
// belong to the content model, not this template. ONE deliberate exception:
// the dogfood section's eyebrow/headline/intro are authored directly below
// (see the `dogfood` const), because colleague.ts — already committed on
// this branch — carries no data field for that section, and this page
// composes strictly from what colleague.ts and colleague-captures.ts already
// export, touching neither file.
//
// Every terminal below replays a real captured session from
// ../../data/colleague-captures.ts — nothing on this page runs colleague, in
// the browser or anywhere else. All eleven capture panes that module
// exports appear exactly once, each in the section it documents — including
// dogfoodReview, the pre-PR review of this page's own diff, rendered in the
// dogfood section below. That pane was appended only once the run
// (7bd1b67432d0) existed; until then the module deliberately exported no
// placeholder for it — no invented transcript ever stood in for it.
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import ClosingBand from "../../components/ClosingBand.astro";
import SectionIntro from "../../components/SectionIntro.astro";
import StructuredCard from "../../components/StructuredCard.astro";
import ColleagueDiagram from "../../components/ColleagueDiagram.astro";
import ColleagueTerminal from "../../components/ColleagueTerminal.astro";
import site from "../../data/site";
import colleague from "../../data/colleague";
import {
  identityWhoami,
  tauiState,
  workDirtyRefusal,
  workFlightRun,
  rolesList,
  lobesSparkCortex,
  lobesThorSenses,
  selfBuildTrace,
  dogfoodExplore,
  dogfoodFeedback,
  dogfoodReview,
} from "../../data/colleague-captures";

// Dogfood copy, authored here rather than in colleague.ts — see the header
// comment above for why. Every claim below matches the provenance already
// documented on the panes this section renders (colleague-captures.ts:
// selfBuildTrace, dogfoodExplore, dogfoodFeedback, dogfoodReview — the
// pre-PR review pane carries its own provenance comment there).
const dogfood = {
  eyebrow: "dogfood",
  headline: "It runs on real work — this page included",
  intro: [
    "Every capture on this page is a real session, and four of them prove the point on colleague itself, not just in prose. The step trace below is ported straight from the public repo: colleague once built its own website in eight bounded steps, with no step failing.",
    "The other three are this very page. While it was being specced, colleague explored its own repo as ask-colleague's second, independent mind, and that run was graded through the same ROI loop described above. Then, before this page's pull request opened, colleague reviewed the diff itself — its one real catch shipped, recorded as a first-class deviation on the plan's ledger.",
  ],
};

---

<Layout
  title={`colleague · Agents · ${site.hero.title}`}
  description={colleague.hero.metaDescription}
>
  <PageHero title={colleague.hero.title} intro={colleague.hero.intro} />

  <!-- fast facts -->
  <section class="section facts-section" aria-label="Fast facts">
    <div class="container page-rail">
      <ul class="facts">
        {
          colleague.facts.map((fact, i) => (
            <li
              class="fact"
              data-reveal
              style={`--reveal-delay: ${Math.min(i * 0.07, 0.28)}s`}
            >
              <span class="fact-label muted">{fact.label}</span>
              <span class="fact-value">
                {fact.href ? (
                  <a
                    href={fact.href}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {fact.value}
                  </a>
                ) : (
                  fact.value
                )}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- the paradigm -->
  <section id="paradigm" class="section" aria-labelledby="paradigm-title">
    <div class="container page-rail">
      <SectionIntro
        eyebrow={colleague.paradigm.eyebrow}
        title={colleague.paradigm.headline}
        titleId="paradigm-title"
        intro={colleague.paradigm.intro}
      />
      <div class="diagram-wrap" data-reveal>
        <ColleagueDiagram caption="One runtime, many minds, in one glance: the top band is one CockpitState rendered three honest ways; the bottom band is cortex and senses, resolved by role from the lobes gateway. Two facts, joined by the one runtime that consumes one and renders the other." />
      </div>
      <ul class="structured-card-grid">
        {
          colleague.paradigm.cards.map((card, i) => (
            <StructuredCard
              title={card.name}
              body={card.detail}
              revealDelay={Math.min(i * 0.07, 0.28)}
            />
          ))
        }
      </ul>
      <div class="term-narrow" data-reveal>
        <ColleagueTerminal pane={identityWhoami} />
      </div>
    </div>
  </section>

  <!-- three tiers -->
  <section id="tiers" class="section" aria-labelledby="tiers-title">
    <div class="container page-rail">
      <SectionIntro
        eyebrow={colleague.tiers.eyebrow}
        title={colleague.tiers.headline}
        titleId="tiers-title"
        intro={colleague.tiers.intro}
      />
      <ul class="structured-card-grid">
        {
          colleague.tiers.cards.map((tier, i) => (
            <StructuredCard
              meta={tier.surface}
              title={tier.name}
              body={tier.detail}
              footerItems={tier.commands.split(" · ")}
              revealDelay={Math.min(i * 0.08, 0.24)}
            />
          ))
        }
      </ul>
      <div class="term-grid">
        <div data-reveal>
          <ColleagueTerminal pane={tauiState} />
        </div>
      </div>
    </div>
  </section>

  <!-- the work loop -->
  <section id="work-loop" class="section" aria-labelledby="work-loop-title">
    <div class="container page-rail">
      <SectionIntro
        eyebrow={colleague.work.eyebrow}
        title={colleague.work.headline}
        titleId="work-loop-title"
        intro={colleague.work.intro}
      />
      <ul class="structured-card-grid">
        {
          colleague.work.cards.map((card, i) => (
            <StructuredCard
              title={card.name}
              body={card.detail}
              footerItems={card.verbs.split(" · ")}
              revealDelay={Math.min(i * 0.07, 0.35)}
            />
          ))
        }
      </ul>
      <!-- The short refusal and full flight run share the same reading rail.
           Stacking keeps both captures legible without breaking the section
           edge established by the heading above. -->
      <div class="term-grid">
        <div data-reveal>
          <ColleagueTerminal pane={workDirtyRefusal} />
        </div>
        <div data-reveal style="--reveal-delay: 0.12s">
          <ColleagueTerminal pane={workFlightRun} start={1.4} />
        </div>
      </div>
    </div>
  </section>

  <!-- the workforce -->
  <section id="workforce" class="section" aria-labelledby="workforce-title">
    <div class="container page-rail">
      <SectionIntro
        eyebrow={colleague.subagents.eyebrow}
        title={colleague.subagents.headline}
        titleId="workforce-title"
        intro={colleague.subagents.intro}
      />
      <div
        class="table-wrap card"
        data-reveal
        style="--reveal-delay: 0.1s"
        tabindex="0"
        role="region"
        aria-label="subagent roles table"
      >
        <table>
          <thead>
            <tr>
              <th>role</th>
              <th>access</th>
              <th>tools</th>
              <th>use</th>
            </tr>
          </thead>
          <tbody>
            {
              colleague.subagents.roles.map((role) => (
                <tr>
                  <td>
                    <code>{role.name}</code>
                  </td>
                  <td>
                    <span
                      class={`access ${role.readOnly ? "access-readonly" : "access-full"}`}
                    >
                      {role.readOnly ? "read-only" : "full"}
                    </span>
                  </td>
                  <td class="tools-cell muted">{role.tools}</td>
                  <td class="use-cell muted">{role.use}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <div class="term-grid">
        <div data-reveal>
          <ColleagueTerminal pane={rolesList} wrap />
        </div>
      </div>
    </div>
  </section>

  <!-- cortex & senses -->
  <section
    id="cortex-senses"
    class="section"
    aria-labelledby="cortex-senses-title"
  >
    <div class="container page-rail">
      <SectionIntro
        eyebrow={colleague.cortexSenses.eyebrow}
        title={colleague.cortexSenses.headline}
        titleId="cortex-senses-title"
        intro={colleague.cortexSenses.intro}
      />
      <ul class="structured-card-grid">
        {
          colleague.cortexSenses.cards.map((card, i) => (
            <StructuredCard
              meta={card.role}
              title={card.name}
              body={card.detail}
              revealDelay={Math.min(i * 0.08, 0.24)}
            />
          ))
        }
      </ul>
      <!-- The mesh pair stays sequential on the reading rail: spark carries
           cortex, then Thor carries senses. -->
      <div class="term-grid">
        <div data-reveal>
          <ColleagueTerminal pane={lobesSparkCortex} />
        </div>
        <div data-reveal style="--reveal-delay: 0.12s">
          <ColleagueTerminal pane={lobesThorSenses} start={1.4} />
        </div>
      </div>
    </div>
  </section>

  <!-- eidetic memory -->
  <section id="memory" class="section" aria-labelledby="memory-title">
    <div class="container page-rail">
      <SectionIntro
        eyebrow={colleague.memory.eyebrow}
        title={colleague.memory.headline}
        titleId="memory-title"
        intro={colleague.memory.intro}
      />
      <div class="measured-grid">
        {
          colleague.memory.measured.map((leg, i) => (
            <div
              class="card measured-card"
              data-reveal
              style={`--reveal-delay: ${Math.min(i * 0.12, 0.12)}s`}
            >
              <span class="measured-leg">{leg.leg}</span>
              <span class="measured-workitem muted">{leg.workItem}</span>
              <dl class="measured-stats">
                <div>
                  <dt>steps</dt>
                  <dd>{leg.steps}</dd>
                </div>
                <div>
                  <dt>model turns</dt>
                  <dd>{leg.modelTurns}</dd>
                </div>
                <div>
                  <dt>tokens</dt>
                  <dd>{leg.tokens}</dd>
                </div>
                <div>
                  <dt>duration</dt>
                  <dd>{leg.duration}</dd>
                </div>
              </dl>
            </div>
          ))
        }
      </div>
      <p class="measured-note muted" data-reveal style="--reveal-delay: 0.16s">
        {colleague.memory.measuredNote}
      </p>
    </div>
  </section>

  <!-- more surfaces -->
  <section
    id="more-surfaces"
    class="section"
    aria-labelledby="more-surfaces-title"
  >
    <div class="container page-rail">
      <SectionIntro
        eyebrow={colleague.moreSurfaces.eyebrow}
        title={colleague.moreSurfaces.headline}
        titleId="more-surfaces-title"
        intro={colleague.moreSurfaces.intro}
      />
      <ul class="structured-card-grid">
        {
          colleague.moreSurfaces.cards.map((card, i) => (
            <StructuredCard
              title={card.name}
              body={card.detail}
              revealDelay={Math.min(i * 0.05, 0.4)}
            />
          ))
        }
      </ul>
    </div>
  </section>

  <!-- dogfood: real captures proving the whole page on colleague's own work -->
  <section id="dogfood" class="section" aria-labelledby="dogfood-title">
    <div class="container page-rail">
      <SectionIntro
        eyebrow={dogfood.eyebrow}
        title={dogfood.headline}
        titleId="dogfood-title"
        intro={dogfood.intro}
      />
      <!-- ported: the self-build drive, a committed public artifact -->
      <div class="term-grid">
        <div data-reveal>
          <ColleagueTerminal pane={selfBuildTrace} />
        </div>
      </div>
      <!-- fresh run: the second mind reads its own repo, then that run is
           graded — closing the ROI loop described in "more surfaces" above -->
      <div class="term-grid">
        <div data-reveal>
          <ColleagueTerminal pane={dogfoodExplore} />
        </div>
        <div data-reveal style="--reveal-delay: 0.12s">
          <ColleagueTerminal pane={dogfoodFeedback} start={1.4} />
        </div>
      </div>
      <!-- fresh run: the pre-PR review of this very page's committed diff —
           captured once the run existed, exactly as the placeholder that
           previously stood here promised. Its one adopted catch is
           deviation d1 on the plan's ledger. -->
      <div class="term-grid">
        <div data-reveal>
          <ColleagueTerminal pane={dogfoodReview} start={0.5} />
        </div>
      </div>
    </div>
  </section>

  <!-- what's next, from the open tracker -->
  <section id="whats-next" class="section" aria-labelledby="whats-next-title">
    <div class="container page-rail">
      <SectionIntro
        eyebrow={colleague.whatsNext.eyebrow}
        title={colleague.whatsNext.headline}
        titleId="whats-next-title"
        intro={colleague.whatsNext.intro}
      />
      <ul class="themes">
        {
          colleague.whatsNext.themes.map((theme, i) => (
            <li
              class="card theme-card"
              data-reveal
              style={`--reveal-delay: ${Math.min(i * 0.08, 0.24)}s`}
            >
              <h3 class="theme-name">{theme.name}</h3>
              <p class="theme-direction muted">{theme.direction}</p>
              <ul class="theme-issues">
                {theme.issues.map((issue) => (
                  <li>
                    <a
                      href={issue.url}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      <span class="issue-num">#{issue.number}</span>{" "}
                      {issue.title}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <ClosingBand
    name={colleague.hero.title}
    paragraphs={colleague.closing.paragraphs}
    actions={[
      {
        href: colleague.closing.repoUrl,
        label: colleague.closing.repoCta,
      },
      {
        href: colleague.closing.pypiUrl,
        label: colleague.closing.pypiCta,
        treatment: "code",
      },
    ]}
  />
</Layout>

<style>
  .section {
    padding-block: clamp(2.6rem, 6vh, 4.2rem);
  }

  .facts-section {
    padding-block: 0 1rem;
  }

  /* fast facts */
  .facts {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 0.9rem;
  }

  .fact {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    padding: 0.55rem 1.05rem;
    background: var(--surface);
    border: 1px solid var(--line-soft);
    border-radius: 999px;
    box-shadow: var(--shadow);
    font-size: var(--ac-type-ui);
  }

  .fact-label {
    font-size: var(--ac-type-meta);
    font-weight: 640;
    line-height: var(--ac-leading-ui);
    letter-spacing: var(--ac-tracking-caps);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .fact-value {
    font-family: var(--font-mono);
    font-size: var(--ac-type-ui);
    white-space: nowrap;
  }

  @media (max-width: 480px) {
    .fact-value {
      white-space: normal;
      overflow-wrap: anywhere;
    }
  }

  /* the paradigm */
  .diagram-wrap {
    margin-block:
      var(--ac-space-diagram-before)
      var(--ac-space-diagram-after);
    max-width: 46rem;
    margin-inline: auto;
  }

  /* The identity probe uses the full reading rail, matching the terminal
     captures in the sections below. */
  .term-narrow {
    width: 100%;
    max-width: none;
    margin-top: 2.2rem;
  }

  /* the workforce: roles table + the live capture beneath it */
  .table-wrap {
    margin-top: 2.2rem;
    padding: 1.5rem 1.6rem;
    overflow-x: auto;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--ac-type-ui);
    line-height: var(--ac-leading-card);
  }

  th {
    text-align: left;
    font-weight: 620;
    font-size: var(--ac-type-meta);
    line-height: var(--ac-leading-ui);
    letter-spacing: var(--ac-tracking-caps);
    text-transform: uppercase;
    color: var(--ink-soft);
    padding: 0.35rem 1rem 0.55rem 0;
    border-bottom: 1px solid var(--line);
    white-space: nowrap;
  }

  td {
    padding: 0.7rem 1rem 0.7rem 0;
    border-bottom: 1px solid var(--line-soft);
    vertical-align: top;
  }

  tr:last-child td {
    border-bottom: none;
  }

  .tools-cell,
  .use-cell {
    font-size: var(--ac-type-ui);
  }

  .tools-cell {
    font-family: var(--font-mono);
    font-size: var(--ac-type-meta);
    min-width: 20rem;
  }

  .access {
    display: inline-block;
    white-space: nowrap;
    padding: 0.1rem 0.6rem;
    border-radius: 999px;
    font-size: var(--ac-type-meta);
    font-weight: 620;
    line-height: var(--ac-leading-ui);
    letter-spacing: var(--ac-tracking-caps);
  }

  .access-readonly {
    color: var(--accent-strong);
    border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
  }

  .access-full {
    color: var(--ink-soft);
    border: 1px dashed var(--line);
  }

  /* eidetic memory: the measured pair */
  .measured-grid {
    margin-top: 2.2rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 1.1rem;
  }

  .measured-card {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1.4rem 1.5rem;
  }

  .measured-leg {
    font-family: var(--font-mono);
    font-size: var(--ac-type-component-title);
    line-height: var(--ac-leading-ui);
    font-weight: 600;
    letter-spacing: var(--ac-tracking-flat);
    text-transform: uppercase;
    color: var(--accent);
  }

  .measured-workitem {
    font-family: var(--font-mono);
    font-size: var(--ac-type-meta);
  }

  .measured-stats {
    margin: 0.7rem 0 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.6rem 1rem;
  }

  .measured-stats div {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .measured-stats dt {
    font-size: var(--ac-type-micro);
    font-weight: 640;
    line-height: var(--ac-leading-ui);
    letter-spacing: var(--ac-tracking-caps);
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .measured-stats dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 600;
  }

  .measured-note {
    margin-top: 1.6rem;
    max-width: var(--ac-measure-prose);
    font-size: 1rem;
    line-height: var(--ac-leading-lede);
    padding-left: 1rem;
    border-left: 2px solid var(--accent);
  }

  /* more surfaces */
  .surfaces {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
  }

  /* captures, shared across sections */
  .term-grid {
    margin-top: 2.2rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.3rem;
    align-items: start;
  }

  .term-grid > * {
    min-width: 0;
  }

  .term-grid + .term-grid {
    margin-top: 1.3rem;
  }

  /* what's next */
  .themes {
    list-style: none;
    margin-top: 2.2rem;
    display: grid;
    gap: 1.1rem;
  }

  .theme-card {
    padding: 1.6rem 1.8rem;
  }

  .theme-name {
    margin-bottom: 0.4em;
  }

  .theme-direction {
    font-size: 1rem;
    line-height: var(--ac-leading-card);
    max-width: var(--ac-measure-prose);
  }

  .theme-issues {
    list-style: none;
    margin-top: 1rem;
    display: grid;
    gap: 0.4rem;
  }

  .theme-issues li {
    font-size: 1rem;
    line-height: var(--ac-leading-card);
  }

  .issue-num {
    font-family: var(--font-mono);
    font-size: var(--ac-type-meta);
    font-weight: 600;
  }

</style>
