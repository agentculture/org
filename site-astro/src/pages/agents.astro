---
import AgentDirectoryCard from "../components/AgentDirectoryCard.astro";
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import site from "../data/site";

const { agents, hero } = site;

// Preserve the data layer's group order; skip groups with no entries.
const groups = agents.groups
  .map(({ id, label }) => ({
    id,
    label,
    entries: agents.entries.filter((entry) => entry.groupId === id),
  }))
  .filter((group) => group.entries.length > 0);
---

<Layout
  title={`Agents · ${hero.title}`}
  description={agents.intro[0] ?? hero.tagline}
>
  <PageHero title="Agents" intro={agents.intro} />

  <nav class="group-nav container wide-rail" aria-label="Browse agents by area">
    <span class="group-nav-label">Browse by area</span>
    <ul>
      {
        groups.map((group) => (
          <li>
            <a href={`#${group.id}`}>
              <span>{group.label}</span>
              <span class="count" aria-label={`${group.entries.length} agents`}>
                {group.entries.length}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  {
    groups.map((group) => (
      <section id={group.id} class="group" aria-labelledby={`${group.id}-title`}>
        <div class="container wide-rail">
          <h2 id={`${group.id}-title`} class="group-label" data-reveal>
            {group.label}
          </h2>
          <ul class="grid">
            {group.entries.map((agent, i) => (
              <li data-reveal style={`--reveal-delay: ${Math.min(i * 0.08, 0.32)}s`}>
                <AgentDirectoryCard agent={agent} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    ))
  }
</Layout>

<style>
  .group-nav {
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
    padding-block: 1rem;
    border-block: 1px solid var(--line-soft);
  }

  .group-nav-label {
    display: block;
    margin-bottom: 0.7rem;
    color: var(--ink-soft);
    font-size: var(--ac-type-meta);
    font-weight: 650;
    line-height: var(--ac-leading-ui);
    letter-spacing: var(--ac-tracking-caps);
    text-transform: uppercase;
  }

  .group-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    list-style: none;
  }

  .group-nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--ink-soft);
    font-size: var(--ac-type-ui);
    font-weight: 560;
    text-decoration: none;
  }

  .group-nav a:hover {
    border-color: var(--accent);
    color: var(--ink);
  }

  .count {
    display: inline-grid;
    place-items: center;
    min-width: 1.45rem;
    min-height: 1.45rem;
    padding-inline: 0.3rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--ac-type-micro);
  }

  .group {
    padding-block: 1.2rem 2.6rem;
  }

  .group-label {
    margin-bottom: 1.3rem;
    color: var(--ink-soft);
    font-family: var(--font-body);
    font-size: var(--ac-type-component-title);
    font-variation-settings: normal;
    font-weight: 620;
    line-height: var(--ac-leading-ui);
    letter-spacing: var(--ac-tracking-caps);
    text-transform: uppercase;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 1.2rem;
    list-style: none;
  }
</style>
